    <string name="trash_dna_temp_fast_body">Sumy skanowania lokalnego pokazują, że pliki tymczasowe rosną szybciej niż inne kategorie jednorazowe.</string>
    <string name="trash_dna_apk_recur_title">Resztki APK powtarzają się</string>
    <string name="trash_dna_apk_recur_body">Pozostałości pakietu APK występowały w co najmniej dwóch sesjach skanowania przechowywanych lokalnie.</string>
